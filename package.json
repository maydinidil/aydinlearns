{
  "name": "aydinlearns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node tests/e2e/smoke.ts",
    "check:imports": "node tools/import-check.ts",
    "extract": "node tools/extract.ts",
    "extract:ga4": "node tools/extract-ga4.ts",
    "check:errata": "node tools/check-errata.ts",
    "check:content": "node tools/check-content.ts",
    "record:solver": "node tools/record-solver.ts",
    "export:solver-view": "node tools/export-solver-view.ts",
    "export:choice-view": "node tools/export-choice-view.ts",
    "record:choice-solver": "node tools/record-choice-solver.ts",
    "report:window": "node tools/report-window.ts",
    "build:data": "pipeline\\.venv\\Scripts\\python.exe pipeline/build_course_db.py",
    "dev:server": "node --watch server/main.ts --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node server/main.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@duckdb/node-api": "1.5.6-r.1",
    "@hono/node-server": "2.1.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "@marimo-team/codemirror-sql": "0.3.0",
    "playwright": "1.63.0"
  }
}
