{
  "name": "aydinlearns",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import ./tests/helpers/register-tsx.ts --test \"tests/**/*.test.ts\"",
    "test:e2e": "node tests/e2e/smoke.ts",
    "check:imports": "node tools/import-check.ts",
    "extract": "node tools/extract.ts",
    "extract:ga4": "node tools/extract-ga4.ts",
    "check:errata": "node tools/check-errata.ts",
    "check:content": "node tools/check-content.ts",
    "record:solver": "node tools/record-solver.ts",
    "export:solver-view": "node tools/export-solver-view.ts",
    "export:choice-view": "node tools/export-choice-view.ts",
    "record:choice-solver": "node tools/record-choice-solver.ts",
    "export:lab-view": "node tools/export-lab-view.ts",
    "record:lab-solver": "node tools/record-lab-solver.ts",
    "export:case-view": "node tools/export-case-view.ts",
    "record:case-solver": "node tools/record-case-solver.ts",
    "report:window": "node tools/report-window.ts",
    "build:data": "pipeline\\.venv\\Scripts\\python.exe pipeline/build_course_db.py",
    "prep:datasets": "node tools/prep-datasets.ts",
    "dev:server": "node --watch server/main.ts --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import ./server/telemetry.ts server/main.ts",
    "journey": "node --env-file-if-exists=.env tools/journey.ts",
    "eval:tutor": "node --env-file-if-exists=.env tools/tutor-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@duckdb/node-api": "1.5.6-r.1",
    "@hono/node-server": "2.1.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "hono": "4.13.12",
    "openai": "7.27.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "@marimo-team/codemirror-sql": "0.3.0",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0"
  }
}
