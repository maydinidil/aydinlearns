# Copy this file to .env (which git ignores) to send telemetry to Dash0, or to any OTLP/HTTP endpoint (owner decision D75).
# With either value missing or blank, telemetry stays off and the app makes no network call.
# The endpoint is the "OTLP via HTTP" one in Dash0's settings, without /v1/traces. It depends on the organisation's region,
# for example https://ingress.eu-west-1.aws.dash0.com or https://ingress.europe-west4.gcp.dash0.com.
# The token is a Dash0 auth token (auth_...).
DASH0_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
