# Copy this file to .env (which git ignores) to send telemetry to Dash0 or any OTLP/HTTP endpoint (owner decision D75),
# or to change where the study journey is kept (D77).
# With either DASH0_ value missing or blank, telemetry stays off and the app makes no network call.
# The endpoint is the "OTLP via HTTP" one in Dash0's settings, without /v1/traces. It depends on the organisation's region,
# for example https://ingress.eu-west-1.aws.dash0.com or https://ingress.europe-west4.gcp.dash0.com.
# The token is a Dash0 auth token (auth_...).
DASH0_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=

# The study journey (D77) is kept on this computer, in journey/. AYDINLEARNS_JOURNEY=off (or false, 0, no) stops the file;
# with telemetry on, the events still go to the telemetry endpoint. Any other word leaves the file on, and the app says so when it starts.
# AYDINLEARNS_JOURNEY_DIR keeps it in another folder.
AYDINLEARNS_JOURNEY=
AYDINLEARNS_JOURNEY_DIR=

# The AI tutor (owner decisions D91 to D99). Its keys are optional here: the usual place is Settings, in the app, which keeps them in
# tutor-keys.json in this folder (git ignores it). A key saved in Settings wins over one here. Settings also switches the tutor on or
# off and picks its model, its effort and the daily limit. With no key the tutor is off and the app makes no outside call.
# A key here is read once when the app starts and is never sent to the browser, logged or shown.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AYDINLEARNS_KEYS_FILE keeps tutor-keys.json somewhere else.
AYDINLEARNS_KEYS_FILE=
