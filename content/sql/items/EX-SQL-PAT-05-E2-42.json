  "shown_sql": "SELECT a.segment,\n  COUNT(*) FILTER (WHERE i.status = 'paid') AS paid,\n  COUNT(*) FILTER (WHERE i.status = 'open') AS open,\n  COUNT(*) AS invoices\nFROM invoices i\nJOIN accounts a ON a.account_id = i.account_id\nWHERE i.invoice_date BETWEEN DATE '2025-12-01' AND DATE '2025-12-31'\nGROUP BY a.segment",
