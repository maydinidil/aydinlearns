  "time_target_ms": 90000,
  "why_this_works": "",
  "shown_sql": "WITH spend AS (\n  -- one row per month with YouTube spend\n  SELECT CAST(date_trunc('month', a.spend_date) AS DATE) AS month, SUM(a.spend) AS spend_eur\n  FROM ad_spend_daily a\n  JOIN campaigns c ON c.campaign_id = a.campaign_id\n  WHERE c.channel_id = 5\n  GROUP BY CAST(date_trunc('month', a.spend_date) AS DATE)\n)\nSELECT b.month, COALESCE(s.spend_eur, 0) AS spend_eur\nFROM budget_monthly b\nLEFT JOIN spend s ON s.month = b.month\nWHERE b.channel_id = 5\n  AND b.month BETWEEN DATE '2024-01-01' AND DATE '2024-06-01'",
