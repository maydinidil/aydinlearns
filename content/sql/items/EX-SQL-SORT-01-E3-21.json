    "columns": [
      {
        "name": "promo_code",
        "type_class": "text"
      },
      {
        "name": "promo_type",
        "type_class": "text"
      },
      {
        "name": "discount_pct",
        "type_class": "numeric"
      },
      {
        "name": "start_date",
        "type_class": "temporal"
      }
    ],
    "grain": "one row per promotion"
  },
  "rules": {
