  "faded_shape": "WITH ranked AS (  -- one row per product, numbered within its category from the highest cost\n  SELECT category_id, product_id, unit_cost_eur,\n         ROW_NUMBER() OVER (PARTITION BY category_id ORDER BY unit_cost_eur DESC, product_id) AS cost_rank\n  FROM products\n)\n",
  "starter_sql": null,
  "time_target_ms": 120000,
  "why_this_works": "ROW_NUMBER gives every product of a category its own place, product_id settling a tie, so cost_rank <= 2 keeps exactly two products per category."
