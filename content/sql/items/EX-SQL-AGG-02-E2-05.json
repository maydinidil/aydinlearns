      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "product_name",
        "type_class": "text"
      },
      {
        "name": "revenue_eur",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per product"
  },
