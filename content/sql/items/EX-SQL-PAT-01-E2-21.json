  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "Which products make the top 3 of each store by units sold in 2025? Use the sales rows whose order_date falls in 2025 (order_date is a UTC day). Products that tie on units share a place, and the next place skips the places they use, so a tie for third keeps a fourth product. Return four columns, in this order: store_code, product_id, units (the product's 2025 units in that store) and place, its place in the store from 1 for the most units. Return one row for each store and product with a place of 3 or better. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "units",
        "type_class": "numeric"
      },
      {
        "name": "place",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
