  "schema": "mailvora",
  "edge_schema": "mailvora_edge_pat",
  "prompt": "For the users who signed up in 2025, how many were activated within 7 days and then paid within 30 days? A user is activated in time when the first first_campaign_sent event came at most 7 days (168 hours) after signup_ts, and paid in time when the user was activated in time and the first payment (paid_at, refunded or not) came at or after that activation and at most 30 days after it. All times are UTC instants, and no first_campaign_sent event comes before its user's signup_ts. Return four columns, in this order: signed_up, activated_in_7_days, paid_in_30_days (each a number of users) and overall_rate, paid_in_30_days over signed_up, as a fraction between 0 and 1. Return one row. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "signed_up",
        "type_class": "numeric"
      },
      {
        "name": "activated_in_7_days",
        "type_class": "numeric"
      },
      {
        "name": "paid_in_30_days",
        "type_class": "numeric"
      },
      {
        "name": "overall_rate",
