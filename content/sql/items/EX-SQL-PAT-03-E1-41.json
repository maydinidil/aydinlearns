  "why_this_works": "",
  "shown_sql": "WITH monthly AS (\n  -- one row per month with orders at store NL-13\n  SELECT order_month AS month, SUM(net_revenue_eur) AS revenue_eur\n  FROM sales\n  WHERE store_code = 'NL-13'\n  GROUP BY order_month\n)\nSELECT m.month, m.revenue_eur, p.revenue_eur AS revenue_prev_year_eur\nFROM monthly m\nLEFT JOIN monthly p ON p.month = m.month - INTERVAL 1 YEAR\nWHERE m.month BETWEEN DATE '2025-07-01' AND DATE '2025-10-01'",
