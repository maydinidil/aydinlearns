  "faded_shape": "WITH order_totals AS (\n  -- one row per order placed in March 2025 (UTC days of order_ts): its units and revenue, added up before any join\n  SELECT order_id, SUM(quantity) AS units, SUM(quantity * unit_price_eur - line_discount_eur) AS revenue\n  FROM order_lines\n  ",
  "starter_sql": null,
  "time_target_ms": 180000,
  "why_this_works": "Each order's lines are filtered and added up before the join, so the join keeps one row per order and COUNT(*) counts orders.",
  "faded_suffix": "\n  GROUP BY order_id\n)\nSELECT o.channel, COUNT(*) AS orders, SUM(t.units) AS units, SUM(t.revenue) AS revenue\nFROM order_totals t\nJOIN orders o ON o.order_id = t.order_id\nGROUP BY o.channel"
