  "edge_schema": "voltmarkt_edge_agg",
  "prompt": "In 2025, which combinations of store and month had fewer than 350 orders? Use the sales table, which has one row per order line, so count each order_id once. Its order_month column holds the first day of the month the order was placed in. Count only lines dated from 1 January 2025 to 31 December 2025, both days included. Return three columns, in this order: store_code, order_month and n_orders, the number of different orders. Return one row per store and month, and only the pairs with fewer than 350 orders, sorted by store_code from A to Z and then by order_month from earliest to latest.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "order_month",
        "type_class": "temporal"
      },
      {
        "name": "n_orders",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per store and month"
  },
  "rules": {
