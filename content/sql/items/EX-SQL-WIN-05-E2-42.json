  "time_target_ms": 120000,
  "why_this_works": "",
  "shown_sql": "WITH monthly AS (\n  SELECT CAST(date_trunc('month', a.spend_date) AS DATE) AS month, SUM(a.spend) AS spend\n  FROM ad_spend_daily a\n  JOIN campaigns c ON c.campaign_id = a.campaign_id\n  WHERE c.channel_id = 5\n    AND a.spend_date BETWEEN DATE '2025-06-01' AND DATE '2025-09-30'\n  GROUP BY CAST(date_trunc('month', a.spend_date) AS DATE)\n)\nSELECT month, spend,\n  ROUND(AVG(spend) OVER (ORDER BY month ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), 0) AS avg_2m\nFROM monthly",
