  "why_this_works": "",
  "shown_sql": "WITH w AS (\n  SELECT product_id, week_start,\n    COUNT(*) OVER (PARTITION BY product_id ORDER BY week_start ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS weeks_in_window\n  FROM weekly_units\n  WHERE product_id BETWEEN 1 AND 10\n    AND week_start BETWEEN DATE '2025-01-06' AND DATE '2025-03-31'\n)\nSELECT product_id, week_start\nFROM w\nWHERE weeks_in_window = 4",
