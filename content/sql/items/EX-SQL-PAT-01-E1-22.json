  "edge_schema": "mailvora_edge_pat",
  "prompt": "Which campaigns make the top 2 of each channel by clicks in 2025? Use the ad_spend_daily rows whose spend_date, a UTC day, falls in 2025. Campaigns that tie on clicks share a place, and the next place skips the places they use, so a tie for second keeps a third campaign. Return three columns, in this order: channel_name, campaign_id and clicks, the campaign's 2025 clicks. Return one row for each campaign with a place of 2 or better. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "channel_name",
        "type_class": "text"
      },
      {
        "name": "campaign_id",
        "type_class": "numeric"
      },
      {
        "name": "clicks",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
