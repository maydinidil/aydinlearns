  "edge_schema": "voltmarkt_edge_type",
  "prompt": "What margin does Voltmarkt make per unit sold in each parent category? Use the sales table and keep only the order lines that have net_revenue_eur, units and unit_cost_eur all present. A line's margin is net_revenue_eur minus units times unit_cost_eur. Return two columns, in this order: parent_category and margin_per_unit_eur, the sum of the line margins divided by the sum of units, rounded to 2 decimals with ROUND(x, 2). Return one row per parent_category. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "parent_category",
        "type_class": "text"
      },
      {
        "name": "margin_per_unit_eur",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per parent_category"
  },
