  "faded_shape": "WITH versions AS (\n  -- one row per product per price version\n  SELECT product_id, valid_from, list_price_eur,\n",
  "faded_suffix": "\n  FROM price_history\n  WHERE product_id BETWEEN 1 AND 25\n)\nSELECT product_id, valid_from, list_price_eur,\n  ROUND(100.0 * (list_price_eur - prev_price) / prev_price, 1) AS pct_change\nFROM versions",
