  "edge_schema": "ledgerloop_edge_saas",
  "prompt": "How long do users stay away between app sessions? Use every app event in the data. A user's first app event starts a session, and an event more than 30 minutes after the same user's previous event starts a new one; an event exactly 30 minutes later stays in the same session. Measure each gap as the time between the two moments in event_ts, a UTC instant, never between clock times. A break is the time from the last event of one session to the first event of the same user's next session. For each account, give the average of all the breaks of its users (each break counts once, not each user's average), in hours, rounded to 2 decimals with ROUND; a user's last session has no break after it, and an account whose users never had a second session shows avg_break_hours as missing. Return two columns, in this order: account_id and avg_break_hours. Return one row for each account with app events. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "account_id",
        "type_class": "numeric"
      },
      {
        "name": "avg_break_hours",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
  "rules": {
