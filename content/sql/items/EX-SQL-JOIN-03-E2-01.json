  "faded_shape": "WITH ",
  "faded_suffix": "\nSELECT s.product_id, SUM(s.units) AS units, lp.lowest_competitor_eur\nFROM sales s\nJOIN lowest_prices lp ON lp.product_id = s.product_id\nWHERE s.parent_category = 'Audio'\nGROUP BY s.product_id, lp.lowest_competitor_eur",
