  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "Which kind of promotion lifts sales most? For each promo_type, take the promotions of that type that started in 2025 (start_date from 1 January to 31 December 2025), work out each promotion's units on promotion and its baseline units, and add them up per type. A sales line is on a promotion when it carries that promotion's ID in order_lines.promo_id, whatever its date; where two promotions overlap on a product, a line carries only the deeper one, so it counts once. The baseline ends the day before the promotion's start_date and has as many days as the promotion ran, start_date and end_date both counted; it holds every sales line of the promotion's products in those days, whatever promotion the line carries. Days are sales.order_date, the UTC day of the order. Then give uplift_pct, the type's promotion units minus its baseline units, as a percentage of its baseline units, rounded to 1 decimal with ROUND (12.5 for 12.5%), or missing when the baseline units add up to 0. Return four columns, in this order: promo_type, promo_units, baseline_units and uplift_pct. Return one row for each promo_type with a promotion that started in 2025. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "promo_type",
        "type_class": "text"
      },
      {
        "name": "promo_units",
        "type_class": "numeric"
      },
      {
        "name": "baseline_units",
        "type_class": "numeric"
      },
      {
        "name": "uplift_pct",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
