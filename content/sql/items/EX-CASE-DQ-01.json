  "uses_raw": true,
  "prompt": "Marieke, the CFO, needs the list of resent order lines for the till supplier, who will delete them. These tables may hold errors. Two lines are copies of one order line when order_id, product_id, quantity, unit_price_eur, promo_id and line_discount_eur all match, with a missing promo_id matching a missing one. In each such set, the line with the lowest order_line_id is the original and every other line is a resent copy. Return one row for each resent copy, in any store and any month, with four columns in this order: order_line_id, the copy's own ID; original_line_id, the order_line_id of the original it repeats; store_code, the store of its order; and copy_revenue_eur, the copy's quantity times unit_price_eur minus line_discount_eur, as stored. Sort by order_line_id from low to high.",
  "output_contract": {
    "columns": [
      {
        "name": "order_line_id",
        "type_class": "numeric"
      },
      {
        "name": "original_line_id",
        "type_class": "numeric"
      },
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "copy_revenue_eur",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
