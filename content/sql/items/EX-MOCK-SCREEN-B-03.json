      {
        "name": "order_month",
        "type_class": "temporal"
      },
      {
        "name": "web_orders",
        "type_class": "numeric"
      },
      {
        "name": "night_orders",
        "type_class": "numeric"
      },
      {
        "name": "night_pct",
        "type_class": "numeric"
      }
    ],
