  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "For each category, which 3 products earned the most net revenue in 2025, and what share of the category's 2025 revenue did each earn? Use the sales rows whose order_date falls in 2025 (order_date is a UTC day). Keep exactly 3 products per category, or every product when a category has fewer than 3. When products tie on revenue, the lower product_id comes first. The share is the product's revenue as a percentage of the revenue of all the category's products in 2025, 12.5 for 12.5%, rounded to 1 decimal with ROUND. Return four columns, in this order: category_name, product_id, revenue and share_pct. Return one row for each product kept. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "category_name",
        "type_class": "text"
      },
      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "revenue",
        "type_class": "numeric"
      },
      {
        "name": "share_pct",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
