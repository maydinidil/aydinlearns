  "edge_schema": "voltmarkt_edge_case",
  "prompt": "The audio buyer wants to see how each brand's Audio range is priced. Take the products in the Audio categories, category_id from 15 to 20, and give each a cost_tier from its unit_cost_eur: 'budget' when it is under 30.00 euros, 'core' when it is 30.00 or more but under 150.00, 'flagship' when it is 150.00 or more, and 'unknown' when unit_cost_eur is missing. Return three columns, in this order: brand, cost_tier and n_products, the number of products of that brand in that tier. Return one row for each brand and tier that has at least one product. Sort by brand from A to Z, then by cost_tier from A to Z.",
  "output_contract": {
    "columns": [
      {
        "name": "brand",
        "type_class": "text"
      },
      {
        "name": "cost_tier",
        "type_class": "text"
      },
