  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "Which products make the top 2 of each store by units sold in 2025? Use the sales rows whose order_date falls in 2025 (order_date is a UTC day). Products that tie on units share a place, and the next place skips the places they use, so a tie for second keeps a third product. Return three columns, in this order: store_code, product_id and units, the product's 2025 units in that store. Return one row for each store and product with a place of 2 or better. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "units",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
  "rules": {
