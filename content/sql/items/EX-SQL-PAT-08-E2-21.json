  "edge_schema": "ledgerloop_edge_saas",
  "prompt": "How busy is a typical app session at each account? Use every app event in the data. A user's first app event starts a session, and an event more than 30 minutes after the same user's previous event starts a new one; an event exactly 30 minutes later stays in the same session. Measure each gap as the time between the two moments in event_ts, a UTC instant, never between clock times. For each account, give the average number of events in its users' sessions, rounded to 2 decimals with ROUND. Return two columns, in this order: account_id and avg_events_per_session. Return one row for each account with app events. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "account_id",
        "type_class": "numeric"
      },
      {
        "name": "avg_events_per_session",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
  "rules": {
