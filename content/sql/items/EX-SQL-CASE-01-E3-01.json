  "edge_schema": "voltmarkt_edge_case",
  "prompt": "Put Voltmarkt's stores in tiers by their 2025 net revenue. Use the sales table and keep the order lines with an order_date from 2025-01-01 to 2025-12-31, both included. Return three columns, in this order: store_code, revenue_eur, the sum of net_revenue_eur, and tier. tier is the text 'A' when revenue_eur is 3000000 or more, 'B' when it is 2000000 or more but under 3000000, and 'C' when it is under 2000000. A missing net_revenue_eur adds nothing to the sum. Return one row per store_code with 2025 sales, sorted by revenue_eur from highest to lowest. Do not round.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "revenue_eur",
        "type_class": "numeric"
      },
      {
        "name": "tier",
        "type_class": "text"
      }
    ],
    "grain": "one row per store"
  },
  "rules": {
    "order_matters": true,
    "sort_keys": [
      {
        "column": "revenue_eur",
        "desc": true
      }
    ],
    "check_names": false,
