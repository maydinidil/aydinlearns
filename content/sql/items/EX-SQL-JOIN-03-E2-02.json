  "faded_shape": "WITH promo_sizes AS (\n  SELECT promo_id, COUNT(*) AS n_products\n  FROM promotion_products\n  GROUP BY promo_id\n),\n",
  "faded_suffix": "\nSELECT s.promo_id, s.n_products, u.units\nFROM promo_sizes s\nJOIN promo_units u ON u.promo_id = s.promo_id",
