  "time_target_ms": 120000,
  "why_this_works": "",
  "shown_sql": "WITH channel_campaigns AS (\n  SELECT ch.channel_group, ch.channel_name, COUNT(*) AS n_campaigns\n  FROM campaigns c\n  JOIN channels ch ON ch.channel_id = c.channel_id\n  GROUP BY ch.channel_group, ch.channel_name\n),\nranked AS (\n  SELECT channel_group, channel_name, n_campaigns,\n         ROW_NUMBER() OVER (PARTITION BY channel_group ORDER BY n_campaigns DESC, channel_name) AS rn\n  FROM channel_campaigns\n)\nSELECT channel_group, channel_name, n_campaigns\nFROM ranked\nWHERE rn = 1",
