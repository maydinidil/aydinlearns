  "prompt": "Which 5 products launched most recently? Return product_id, product_name and launch_date, in that order, with exactly these column names, newest launch first. Leave out products with a missing launch_date. When products share a launch_date, the lower product_id comes first, and it also decides which product takes the last place. Return exactly 5 rows.",
  "output_contract": {
    "columns": [
      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "product_name",
        "type_class": "text"
      },
      {
        "name": "launch_date",
        "type_class": "temporal"
      }
    ],
    "grain": "one row per product"
  },
  "rules": {
    "order_matters": true,
    "sort_keys": [
      {
        "column": "launch_date",
        "desc": true
      },
      {
        "column": "product_id",
        "desc": false
      }
    ],
    "check_names": true,
    "allow_extra_columns": false,
