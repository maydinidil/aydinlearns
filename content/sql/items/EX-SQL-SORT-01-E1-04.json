        "type_class": "numeric",
        "precision": "count"
      },
      {
        "name": "product_name",
        "type_class": "text",
        "precision": "exact"
      },
      {
        "name": "launch_date",
        "type_class": "temporal",
        "precision": "exact"
      }
    ],
    "strict_temporal_type": false,
    "trim_strings": false,
    "tie_policy": "none",
    "key_columns": [
      "product_id"
    ],
    "timeout_ms": 5000,
    "set_semantics": false,
    "case_insensitive": false,
    "strict_column_order": false
  },
  "hints": [
    "Next, write the sort and the row limit. Sort newest launch first with the tie-break, then cut the list to 5 rows.",
    "ORDER BY comes first, with the date and then the tie-break, and LIMIT comes last. LIMIT only keeps the right rows when the ORDER BY before it is complete."
  ],
