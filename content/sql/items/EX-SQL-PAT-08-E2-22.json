  "edge_schema": "mailvora_edge_pat",
  "prompt": "For each month from October to December 2025, how many activation sessions started, and how many events did a session hold on average? Work the sessions out over each user's whole history and count a session in the UTC month of its first event, with all of its events. A user's first activation event starts a session, and an event more than 30 minutes after the same user's previous event starts a new one; an event exactly 30 minutes later stays in the same session. Measure each gap as the time between the two moments in event_ts, a UTC instant. When two events of a user share a moment, take them in event_name order, A to Z. Round the average to 2 decimals with ROUND. Return three columns, in this order: month_start, the first day of the month, sessions and avg_events. Return one row for each month. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "month_start",
        "type_class": "temporal"
      },
      {
        "name": "sessions",
        "type_class": "numeric"
      },
      {
        "name": "avg_events",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
