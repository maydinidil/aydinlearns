  "prompt": "Marketing suspects that users who sign up with a local email domain behave differently. A signup has a local domain when the part of its email_domain after the last full stop (the top-level domain, such as de in gmx.de) is the signup's country_code, ignoring letter case, as de is for DE. Take the users whose signup_ts, a UTC moment, is from 1 July 2025 00:00 up to but not including 1 October 2025 00:00. For each country_code, return four columns, in this order: country_code; signups, the number of those users; local_signups, the number of them with a local domain; and local_pct, 100 times local_signups divided by signups, rounded to 1 decimal. Sort by country_code from A to Z.",
  "output_contract": {
    "columns": [
      {
        "name": "country_code",
        "type_class": "text"
      },
      {
        "name": "signups",
        "type_class": "numeric"
      },
      {
        "name": "local_signups",
        "type_class": "numeric"
      },
      {
        "name": "local_pct",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
