  "faded_shape": "WITH monthly AS (\n  -- one row per month with orders, 2024 and 2025\n  SELECT order_month AS month, SUM(net_revenue_eur) AS revenue_eur\n  FROM sales\n  WHERE order_date BETWEEN DATE '2024-01-01' AND DATE '2025-12-31'\n  GROUP BY order_month\n)\n",
  "faded_suffix": "\nWHERE m.month >= DATE '2025-01-01'",
  "starter_sql": null,
  "time_target_ms": 210000,
  "why_this_works": "Joining on the month minus one year finds the same month of 2024 by date, so a month with no orders a year before stays missing instead of shifting the series."
