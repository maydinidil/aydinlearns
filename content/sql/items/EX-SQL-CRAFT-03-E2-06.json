  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "Where did Voltmarkt grow like for like? For each country (the store's stores.country_code), give the revenue growth from 2024 to 2025 over the stores open for the whole of both years only: opened_on on or before 1 January 2024, and close_date missing or on or after 31 December 2025. Growth is 100 times (2025 net revenue minus 2024 net revenue) divided by 2024 net revenue, rounded to 2 decimals with ROUND, with net_revenue_eur from sales by sales.order_date, the UTC day. A store that opened or closed during the two years is left out of both years. The webshop counts as a store of its country_code. Return two columns, in this order: country_code and growth_pct. Return one row per country with such a store. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "country_code",
        "type_class": "text"
      },
      {
        "name": "growth_pct",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
