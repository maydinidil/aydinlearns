  "prompt": "What is the average discount of each promotion type, as a share of the price? Use the promotions table and all its promotions. discount_pct holds the discount in percent: 15.00 means 15 percent off. Return two columns, in this order: promo_type and avg_discount_share, the average discount as a share between 0 and 1 (so 15 percent is 0.15), rounded to 3 decimals with ROUND(x, 3). Return one row per promo_type. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "promo_type",
        "type_class": "text"
      },
      {
        "name": "avg_discount_share",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per promo_type"
  },
