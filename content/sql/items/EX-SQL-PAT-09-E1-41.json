  "shown_sql": "SELECT s.order_line_id, p.promo_id\nFROM sales s\nJOIN promotion_products pp ON pp.product_id = s.product_id\nJOIN promotions p ON p.promo_id = pp.promo_id\n  AND s.order_date BETWEEN p.start_date AND p.end_date\nWHERE s.product_id = 379\n  AND s.order_date BETWEEN DATE '2025-10-06' AND DATE '2025-10-12'",
