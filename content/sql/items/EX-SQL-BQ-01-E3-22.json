  "edge_schema": "mailvora_edge_ga4",
  "prompt": "How long are sessions engaged on each device? For each device category, count the sessions that started from 1 to 30 November 2025, by event_date, and their average engagement time in seconds. A session is one user_pseudo_id with one ga_session_id, counted from its session_start event; leave out session_start events whose user_pseudo_id or ga_session_id is missing. A session's engagement time is the sum of the engagement_time_msec parameter (milliseconds, in int_value) over its page_view events of the same days, matched on both IDs; a session with no page_view has 0. The device is device.category of the session_start event. Return device_category, sessions and avg_engagement_sec: the sessions' engagement time added up, divided by the number of sessions, in seconds. Return one row for each device category. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "device_category",
        "type_class": "text"
      },
      {
        "name": "sessions",
        "type_class": "numeric"
      },
      {
        "name": "avg_engagement_sec",
