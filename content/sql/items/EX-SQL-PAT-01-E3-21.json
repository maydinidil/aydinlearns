  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "How much of each category's 2025 net revenue comes from its 2 best-selling products? Use the sales rows whose order_date falls in 2025 (order_date is a UTC day). Take exactly 2 products per category by 2025 revenue, or every product when a category has fewer than 2. When products tie on revenue, the lower product_id comes first. Return four columns, in this order: category_name, top2_revenue (the revenue of those 2 products together), category_revenue (the 2025 revenue of all the category's products) and top2_share_pct, top2_revenue as a percentage of category_revenue, 12.5 for 12.5%, rounded to 1 decimal with ROUND. Return one row for each category with 2025 sales. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "category_name",
        "type_class": "text"
      },
      {
        "name": "top2_revenue",
        "type_class": "numeric"
      },
      {
        "name": "category_revenue",
        "type_class": "numeric"
      },
      {
        "name": "top2_share_pct",
        "type_class": "numeric"
      }
    ],
