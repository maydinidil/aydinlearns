  "shown_sql": "WITH numbered AS (\n  SELECT campaign_id, start_date,\n         ROW_NUMBER() OVER (ORDER BY start_date DESC, campaign_id) AS rn\n  FROM campaigns\n  WHERE channel_id = 2\n)\nSELECT campaign_id, rn\nFROM numbered\nWHERE rn <= 2\n  AND start_date < DATE '2025-01-01'",
