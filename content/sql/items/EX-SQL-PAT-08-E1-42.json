  "time_target_ms": 90000,
  "why_this_works": "",
  "shown_sql": "WITH gaps AS (\n  SELECT user_id, event_ts,\n    LAG(event_ts) OVER (PARTITION BY user_id ORDER BY event_ts, event_name) AS prev_ts\n  FROM activation_events\n  WHERE event_ts >= TIMESTAMPTZ '2025-10-14 00:00:00+00'\n    AND event_ts < TIMESTAMPTZ '2025-10-15 00:00:00+00'\n)\nSELECT user_id, event_ts\nFROM gaps\nWHERE prev_ts IS NULL OR event_ts - prev_ts > INTERVAL '30 minutes'",
