  "faded_shape": "WITH ",
  "faded_suffix": "\nSELECT o.channel, COUNT(*) AS n_orders, SUM(t.order_eur) AS value_eur\nFROM orders o\nJOIN order_totals t ON t.order_id = o.order_id\nGROUP BY o.channel",
