  "edge_schema": "voltmarkt_edge_agg",
  "prompt": "Finance wants to see where Voltmarkt sold below cost in the first half of 2025. Use the order lines with an order_date from 1 January 2025 to 30 June 2025, both days included. A line sold below cost when its net_revenue_eur is less than its units times its unit_cost_eur; a line with a missing units, net_revenue_eur or unit_cost_eur cannot be judged, so it does not count as below cost. For each parent category, return four columns, in this order: parent_category; n_lines, the number of order lines, every line counted; below_cost_lines, the number of lines sold below cost; and below_cost_loss_eur, the total of units times unit_cost_eur minus net_revenue_eur over the lines sold below cost, or 0 when the category has none. Sort by below_cost_lines from highest to lowest, then by parent_category from A to Z.",
  "output_contract": {
    "columns": [
      {
        "name": "parent_category",
        "type_class": "text"
      },
      {
        "name": "n_lines",
        "type_class": "numeric"
      },
      {
        "name": "below_cost_lines",
        "type_class": "numeric"
      },
      {
        "name": "below_cost_loss_eur",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per parent category"
  },
  "rules": {
