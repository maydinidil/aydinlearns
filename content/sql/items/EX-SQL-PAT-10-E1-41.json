  "why_this_works": "",
  "shown_sql": "WITH m AS (\n  SELECT month_end\n  FROM (VALUES (DATE '2025-02-28'), (DATE '2025-03-31'), (DATE '2025-04-30'), (DATE '2025-05-31'), (DATE '2025-06-30')) AS v(month_end)\n), mrr AS (\n  SELECT m.month_end, COALESCE(SUM(e.mrr_delta_local), 0) AS mrr\n  FROM m\n  LEFT JOIN subscription_events e ON e.account_id = 125 AND e.event_date <= m.month_end\n  GROUP BY m.month_end\n)\nSELECT month_end, mrr,\n  CASE WHEN LAG(mrr) OVER (ORDER BY month_end) = 0 AND mrr > 0 THEN 'new'\n       WHEN LAG(mrr) OVER (ORDER BY month_end) > 0 AND mrr = 0 THEN 'churn'\n       ELSE 'other' END AS movement\nFROM mrr",
