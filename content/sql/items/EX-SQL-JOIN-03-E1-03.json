  "faded_shape": "SELECT s.product_id, ph.list_price_eur, SUM(s.units) AS units\nFROM sales s\nJOIN price_history ph ON ph.product_id = s.product_id\nWHERE s.parent_category = 'Audio'\n  AND ",
  "faded_suffix": "\nGROUP BY s.product_id, ph.list_price_eur",
