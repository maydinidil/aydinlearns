  "fading": null,
  "faded_shape": null,
  "starter_sql": "SELECT s.store_code, COUNT(o.order_id) AS orders, SUM(l.quantity) AS units\nFROM orders o\nJOIN order_lines l ON l.order_id = o.order_id\nJOIN stores s ON s.store_id = o.store_id\nWHERE o.order_ts >= TIMESTAMP '2025-04-01 00:00:00'\n  AND o.order_ts < TIMESTAMP '2025-05-01 00:00:00'\nGROUP BY s.store_code",
  "time_target_ms": 180000,
  "why_this_works": "Adding the lines up per order before the join keeps one row per order, so the count is a count of orders.",
