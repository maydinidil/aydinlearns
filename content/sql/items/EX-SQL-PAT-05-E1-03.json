        "type_class": "text"
      },
      {
        "name": "orders_2024",
        "type_class": "numeric"
      },
      {
        "name": "orders_2025",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per store with orders in 2024 or 2025"
  },
