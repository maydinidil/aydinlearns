  "options": [
    {
      "oid": "o0bb36a4",
      "text": "Cast the text to DATE",
      "misconception_id": "MIS-SQL-BQ-01-03",
      "code": {
        "lang": "bigquery",
        "sql": "SELECT CAST(event_date AS DATE) AS event_day\nFROM `mailvora-web.analytics_254316.events_20251001`"
      }
    },
    {
      "oid": "oe2acbc6",
      "text": "Parse the text with a dashed format",
      "misconception_id": "ERR-LOG-55",
      "code": {
        "lang": "bigquery",
        "sql": "SELECT PARSE_DATE('%Y-%m-%d', event_date) AS event_day\nFROM `mailvora-web.analytics_254316.events_20251001`"
      }
    },
    {
      "oid": "ob546008",
      "text": "Use the strptime function",
      "misconception_id": "MIS-SQL-BQ-01-04",
      "code": {
        "lang": "bigquery",
        "sql": "SELECT strptime(event_date, '%Y%m%d') AS event_day\nFROM `mailvora-web.analytics_254316.events_20251001`"
      }
    },
    {
      "oid": "o2569559",
      "text": "Parse the text with its own format",
      "misconception_id": null,
      "code": {
        "lang": "bigquery",
        "sql": "SELECT PARSE_DATE('%Y%m%d', event_date) AS event_day\nFROM `mailvora-web.analytics_254316.events_20251001`"
      }
    }
