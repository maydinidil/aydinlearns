  "shown_sql": "WITH cohort AS (  -- one row per account created from October to December 2025\n  SELECT account_id, CAST(date_trunc('month', created_at) AS DATE) AS cohort_month\n  FROM accounts\n  WHERE created_at >= TIMESTAMP '2025-10-01 00:00:00' AND created_at < TIMESTAMP '2026-01-01 00:00:00'\n),\nmonths AS (  -- one row per cohort month\n  SELECT DISTINCT cohort_month\n  FROM cohort\n)\nSELECT m.cohort_month, k.month_offset\nFROM months m\nCROSS JOIN range(0, 4) AS k(month_offset)",
