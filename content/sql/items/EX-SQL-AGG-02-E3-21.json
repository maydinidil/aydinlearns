  "edge_schema": "voltmarkt_edge_agg",
  "prompt": "For December 2024, build a small scorecard of each parent category in each ship-to country. Use the sales table, where country_code is the country an order ships to, and count only order lines dated from 1 December 2024 to 31 December 2024, both days included. Return five columns, in this order: parent_category, country_code, n_orders, the number of different order_id values, n_products, the number of different product_id values, and units_sold, the sum of units. Return one row per parent_category and country_code combination, sorted by parent_category from A to Z, then by country_code from A to Z. Every order line counts for n_orders and n_products, including a line with missing units, and missing units add nothing to units_sold.",
  "output_contract": {
    "columns": [
      {
        "name": "parent_category",
        "type_class": "text"
      },
      {
        "name": "country_code",
        "type_class": "text"
