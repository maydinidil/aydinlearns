  "edge_schema": "voltmarkt_edge_win",
  "prompt": "What is the second-highest unit cost in each category? Count different costs: products that tie on unit cost share a place, and the next lower cost takes the next place with no gap, so in a category whose two most expensive products both cost 500 euros, the second-highest cost is the next cost below 500. Leave out a category with fewer than two different unit costs. Return two columns, in this order: category_id and second_cost. Return one row for each category kept. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "category_id",
        "type_class": "numeric"
      },
      {
        "name": "second_cost",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
  "rules": {
