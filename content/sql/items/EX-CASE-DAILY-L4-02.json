  "edge_schema": "voltmarkt_edge_interval",
  "prompt": "Sanne, the category manager, plans launch support for next year's new products and asks how quickly new products start selling. Look at every product with a launch_date from 2024-01-01 to 2025-12-31, both days included, that sold at least once. Its first sale date is the UTC date of the earliest order with a line for it; order_ts holds UTC time. Its days to first sale are the days from its launch_date to that first sale: a product that first sold on its launch day has 0, and one that first sold the next day has 1. A new product that never sold is left out. Return one row for each parent category with such products. Return three columns, in this order: parent_category; n_new_products, the number of those products in it; and avg_days_to_first_sale, the average of their days to first sale, rounded to 1 decimal. Sort by parent_category, alphabetically.",
  "output_contract": {
    "columns": [
      {
        "name": "parent_category",
        "type_class": "text"
      },
      {
        "name": "n_new_products",
        "type_class": "numeric"
      },
      {
        "name": "avg_days_to_first_sale",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
