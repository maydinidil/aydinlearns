  "time_target_ms": 120000,
  "why_this_works": "",
  "shown_sql": "WITH flagged AS (\n  SELECT event_id, event_ts,\n    CASE WHEN LAG(event_ts) OVER (ORDER BY event_ts) IS NULL\n      OR event_ts - LAG(event_ts) OVER (ORDER BY event_ts) > INTERVAL '30 minutes' THEN 1 ELSE 0 END AS new_session\n  FROM app_events\n  WHERE user_id = 278\n    AND event_ts >= TIMESTAMPTZ '2025-11-20 09:00:00+00'\n    AND event_ts < TIMESTAMPTZ '2025-11-20 09:40:00+00'\n)\nSELECT event_id,\n  SUM(new_session) OVER (ORDER BY event_ts ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS session_no\nFROM flagged",
