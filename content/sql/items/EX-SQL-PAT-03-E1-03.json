  "faded_shape": "WITH monthly AS (\n  -- one row per month of 2025\n  SELECT order_month AS month, SUM(units) AS units\n  FROM sales\n  WHERE order_date BETWEEN DATE '2025-01-01' AND DATE '2025-12-31'\n  GROUP BY order_month\n)\nSELECT month, units,\n",
  "faded_suffix": "\nFROM monthly",
