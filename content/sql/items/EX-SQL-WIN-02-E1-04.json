  "faded_shape": "WITH campaign_clicks AS (  -- one row per campaign with spend\n  SELECT c.campaign_id, c.channel_id, SUM(a.clicks) AS clicks\n  FROM ad_spend_daily a\n  JOIN campaigns c ON c.campaign_id = a.campaign_id\n  GROUP BY c.campaign_id, c.channel_id\n)\nSELECT campaign_id, channel_id, clicks,\n       ",
