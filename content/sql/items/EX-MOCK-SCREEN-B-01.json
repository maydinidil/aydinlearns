      },
      {
        "name": "campaign_name",
        "type_class": "text",
        "precision": "exact"
      },
      {
        "name": "discount_pct",
        "type_class": "numeric",
        "precision": "exact"
      }
    ],
    "strict_temporal_type": false,
    "trim_strings": false,
    "tie_policy": "none",
    "key_columns": [
      "promo_code"
    ],
    "timeout_ms": 5000,
    "set_semantics": false,
    "case_insensitive": false,
    "strict_column_order": false
  },
  "hints": [
    "Next, write the campaign_name column, which falls back to the promo_code when the name is missing.",
    "Test for a missing discount with IS NOT NULL: an equals or not-equals sign never matches a missing value."
  ],
