  "prompt": "Marketing is building an archive of the 2025 campaigns. For every promotion that started from 1 January 2025 to 31 December 2025, both days included, return three columns, in this order: promo_code; campaign_name, which is the promo_name, or the promo_code when the promo_name is missing; and discount_pct. Leave out the promotions whose discount_pct is missing. Sort the rows by discount_pct from highest to lowest, and when promotions share a discount, by promo_code from A to Z.",
  "output_contract": {
    "columns": [
      {
        "name": "promo_code",
        "type_class": "text"
      },
      {
        "name": "campaign_name",
        "type_class": "text"
      },
      {
        "name": "discount_pct",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per promotion"
  },
  "rules": {
    "order_matters": true,
    "sort_keys": [
      {
        "column": "discount_pct",
        "desc": true
      },
      {
        "column": "promo_code",
        "desc": false
      }
    ],
    "check_names": false,
    "allow_extra_columns": false,
    "columns": [
