  "edge_schema": "mailvora_edge_case",
  "prompt": "Aoife, the performance marketing manager, needs September 2025 spend, clicks and cost per click for each paid channel for tomorrow's monthly report. The paid channels are the channels outside the unpaid group; organic, direct and referral cost nothing and stay out. A channel's spend and clicks are those of its campaigns on the UTC days of spend from 2025-09-01 to 2025-09-30, both days included. Return one row for each paid channel, including a paid channel that spent nothing in September, with five columns in this order: channel_id; channel_name; spend_eur, the channel's September spend in euros, not rounded, and 0 when it spent nothing; clicks, its September clicks, and 0 when it had none; and cpc_eur, spend_eur divided by clicks, rounded to 2 decimals, and missing when clicks is 0. Sort by spend_eur from high to low, then by channel_id from low to high.",
  "output_contract": {
    "columns": [
      {
        "name": "channel_id",
        "type_class": "numeric"
      },
      {
        "name": "channel_name",
        "type_class": "text"
