  "faded_shape": "WITH ranked AS (  -- one row per campaign, numbered within its channel from the earliest start\n  SELECT channel_id, campaign_id, start_date,\n         ROW_NUMBER() OVER (PARTITION BY channel_id ORDER BY start_date, campaign_id) AS rn\n  FROM campaigns\n)\nSELECT channel_id, campaign_id, start_date\nFROM ranked\n",
