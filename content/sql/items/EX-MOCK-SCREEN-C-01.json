  "edge_schema": "voltmarkt_edge_sort",
  "prompt": "Marketing is planning a campaign for three TV brands and wants to lead with their most expensive products that still cost Voltmarkt less than 1,000 euros a unit. Among the products whose brand is Vistara, Lumio or Nordvue and whose unit_cost_eur is below 1000, which 3 have the highest unit_cost_eur? Products with a missing brand or a missing unit_cost_eur do not count. Return four columns, in this order: product_id, product_name, brand, unit_cost_eur. Sort by unit_cost_eur from highest to lowest; when products tie on unit_cost_eur, the lower product_id comes first and takes the place. Return exactly 3 rows.",
  "output_contract": {
    "columns": [
      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "product_name",
        "type_class": "text"
      },
