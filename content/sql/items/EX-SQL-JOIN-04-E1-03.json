  "faded_shape": "SELECT s.city, SUM(ol.quantity) AS units\nFROM order_lines ol\nJOIN orders o ON o.order_id = ol.order_id\n",
  "faded_suffix": "\nWHERE o.order_ts >= TIMESTAMP '2025-03-03' AND o.order_ts < TIMESTAMP '2025-03-10'\nGROUP BY s.city",
  "starter_sql": null,
  "time_target_ms": 120000,
  "why_this_works": "Each JOIN follows one link, the line to its order and then the order to its store, so every line carries its store's city before SUM adds the units."
