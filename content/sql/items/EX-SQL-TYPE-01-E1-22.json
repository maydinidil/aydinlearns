  "edge_schema": "voltmarkt_edge_type",
  "prompt": "What is the average net revenue of an order line in each ship-to country? Use the sales table, where country_code is the country an order ships to. Return two columns, in this order: country_code and avg_line_revenue_eur, the average net_revenue_eur per order line, rounded to 2 decimals with ROUND(x, 2). Lines with a missing net_revenue_eur are left out of the average completely: they count neither as revenue nor as lines. Return one row per country_code. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "country_code",
        "type_class": "text"
      },
      {
        "name": "avg_line_revenue_eur",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per country_code"
  },
