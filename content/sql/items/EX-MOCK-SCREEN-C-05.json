  "sub_skill": null,
  "difficulty": "E3",
  "company": "voltmarkt",
  "schema": "voltmarkt",
  "edge_schema": "voltmarkt_edge_win",
  "prompt": "The buying team wants the fastest movers of each parent category in the first half of 2025. Use the sales rows whose order_date falls from 1 January 2025 to 30 June 2025, both days included. A product's units_sold is the total of its units in those rows; only products with at least one such row count. Within each parent category, line the products up by units_sold from the highest down and split them into four quarters of as equal a size as possible, in that order: when the number of products does not divide by four, each of the first quarters takes one product more than the later ones. When products tie on units_sold, the product with the lower product_id comes first. Which products are in the first quarter of their parent category? Return four columns, in this order: parent_category, product_id, product_name and units_sold. Sort by parent_category from A to Z, then by units_sold from highest to lowest, then by product_id from low to high.",
  "output_contract": {
    "columns": [
      {
        "name": "parent_category",
        "type_class": "text"
      },
      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "product_name",
        "type_class": "text"
      },
      {
        "name": "units_sold",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
  "rules": {
    "order_matters": true,
    "sort_keys": [
      {
        "column": "parent_category",
        "desc": false
      },
      {
        "column": "units_sold",
        "desc": true
      },
      {
        "column": "product_id",
        "desc": false
      }
    ],
    "check_names": false,
