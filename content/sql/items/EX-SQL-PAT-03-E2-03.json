  "prompt": "Compare each store's net revenue in 2025 with 2024, like for like: only stores open for the whole of both years count, that is, stores that opened on or before 1 January 2024 and have no close_date. The webshop counts as a store. Order dates are UTC days. Return four columns, in this order: store_code, revenue_2024_eur, revenue_2025_eur and growth_pct, the change as a percentage of the 2024 revenue (12.5 for 12.5%), rounded to 1 decimal. Return one row for each such store. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "revenue_2024_eur",
        "type_class": "numeric"
      },
      {
        "name": "revenue_2025_eur",
        "type_class": "numeric"
      },
      {
        "name": "growth_pct",
        "type_class": "numeric"
      }
    ],
