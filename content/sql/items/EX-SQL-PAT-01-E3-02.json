  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "How concentrated is each store's 2025 assortment? For each store, take the products that make its top 3 by units sold in 2025; products that tie on units share a place, and the next place skips the places they use, so a tie for third brings in a fourth product. Use the sales rows whose order_date falls in 2025 (order_date is a UTC day). Return four columns, in this order: store_code, top_units (the 2025 units of those top products together), store_units (all of the store's 2025 units) and top_share_pct, top_units as a percentage of store_units, 12.5 for 12.5%, rounded to 1 decimal with ROUND. Return one row for each store with 2025 sales. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "top_units",
        "type_class": "numeric"
      },
      {
        "name": "store_units",
        "type_class": "numeric"
      },
      {
        "name": "top_share_pct",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
