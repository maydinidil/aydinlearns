  "edge_schema": "ledgerloop_edge_saas",
  "prompt": "How many app sessions started on each UTC day from 1 to 5 December 2025 (both days included)? Work the gaps out over every app event, so an event on 1 December is compared with the user's previous event, even an earlier one. A user's first app event starts a session, and an event more than 30 minutes after the same user's previous event starts a new one; an event exactly 30 minutes later stays in the same session. Measure each gap as the time between the two moments in event_ts, a UTC instant, never between clock times. Count a session on the UTC day of its first event. Return two columns, in this order: session_day and sessions. Return one row for each day with at least one session start. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "session_day",
        "type_class": "temporal"
      },
      {
        "name": "sessions",
        "type_class": "numeric"
      }
    ],
