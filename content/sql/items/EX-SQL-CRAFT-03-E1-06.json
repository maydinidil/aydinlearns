  "edge_schema": "voltmarkt_edge_pat",
  "prompt": "Voltmarkt's board compares 2025 with 2024 like for like. For each store open for the whole of both years (opened_on on or before 1 January 2024, and close_date missing or on or after 31 December 2025), give its net revenue (net_revenue_eur in sales) in 2024 and in 2025, by sales.order_date, the UTC day. A store that opened or closed during the two years is left out. The webshop counts as a store. Return three columns, in this order: store_code, revenue_2024 and revenue_2025. Return one row per such store. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "revenue_2024",
        "type_class": "numeric"
      },
      {
        "name": "revenue_2025",
