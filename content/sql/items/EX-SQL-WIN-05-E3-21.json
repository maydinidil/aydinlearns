  "edge_schema": "voltmarkt_edge_win",
  "prompt": "For products 1 to 50 (product_id from 1 to 50, both included), find the weeks starting from 3 March to 30 June 2025 (week_start, both days included) in which the product sold at least 2 units and at least twice its average weekly units of the 4 weeks before (that week not included). weekly_units holds a row for every product and week, with 0 when nothing sold, and the 4 weeks may reach back before 3 March. Return four columns, in this order: product_id, week_start, units and avg_prev_4w, the 4-week average rounded to 2 decimals. Return one row for each product and week found. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "product_id",
        "type_class": "numeric"
      },
      {
        "name": "week_start",
        "type_class": "temporal"
      },
      {
        "name": "units",
        "type_class": "numeric"
      },
      {
        "name": "avg_prev_4w",
        "type_class": "numeric"
      }
    ],
    "grain": null
  },
