  "edge_schema": "voltmarkt_edge_type",
  "prompt": "Build a monthly scorecard for the last quarter of 2025. Use the sales table and keep the order lines with an order_date from 2025-10-01 to 2025-12-31, both included. Return four columns, in this order: order_month, as the date it holds (the first day of the month); n_orders, the number of different orders (order_id); units_per_order, the total of units divided by n_orders, rounded to 2 decimals with ROUND(x, 2); and web_units_pct, 100 times the units on lines with channel 'web' divided by all units, rounded to 1 decimal with ROUND(x, 1), so 15 percent is 15.0. A missing units value adds nothing to any total. Return one row per order_month. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "order_month",
        "type_class": "temporal"
      },
      {
        "name": "n_orders",
        "type_class": "numeric"
      },
      {
        "name": "units_per_order",
        "type_class": "numeric"
      },
      {
        "name": "web_units_pct",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per order_month"
  },
