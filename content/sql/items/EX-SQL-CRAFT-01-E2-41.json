  "why_this_works": "",
  "shown_sql": "SELECT COUNT(DISTINCT ga_session_id) AS id_values,\n  COUNT(DISTINCT user_pseudo_id || '-' || ga_session_id) AS sessions\nFROM (\n  SELECT user_pseudo_id,\n    list_filter(event_params, lambda p: p.key = 'ga_session_id')[1].value.int_value AS ga_session_id\n  FROM events\n  WHERE event_name = 'session_start'\n    AND event_date = '20251104'\n    AND user_pseudo_id IS NOT NULL\n) AS starts",
