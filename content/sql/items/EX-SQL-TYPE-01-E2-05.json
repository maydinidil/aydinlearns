  "edge_schema": "voltmarkt_edge_type",
  "prompt": "How much net revenue did each store make in 2025, in thousands of euros? Use the sales table and keep the order lines with an order_date from 2025-01-01 to 2025-12-31, both included. Return two columns, in this order: store_code and revenue_k_eur, the total net_revenue_eur divided by 1000, rounded to 1 decimal with ROUND(x, 1), so 2345.67 EUR is 2.3. A missing net_revenue_eur adds nothing to the total. Return one row per store_code. Any row order is fine.",
  "output_contract": {
    "columns": [
      {
        "name": "store_code",
        "type_class": "text"
      },
      {
        "name": "revenue_k_eur",
        "type_class": "numeric"
      }
    ],
    "grain": "one row per store_code"
  },
  "rules": {
    "order_matters": false,
    "sort_keys": [],
    "check_names": false,
    "allow_extra_columns": false,
