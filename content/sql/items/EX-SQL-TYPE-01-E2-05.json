      "store_code"
    ],
    "timeout_ms": 5000,
    "set_semantics": false,
    "case_insensitive": false,
    "strict_column_order": false
  },
  "hints": [
    "Next, keep the 2025 lines and write the calculated column revenue_k_eur, one total per store_code.",
    "Add up the full revenue first, then divide by 1000 and round once, around the whole result. Rounding each line before you add them up loses small amounts that grow into a different total."
  ],
