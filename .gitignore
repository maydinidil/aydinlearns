# Dependencies and build output
node_modules/
dist/
.venv/
__pycache__/

# Generated company data, prepared real datasets and their raw downloads.
# Regenerate from pipeline/ and the manifest; licences forbid redistributing some datasets.
data/

# Attempt log, reports and other learner data. Backed up to a folder outside the repo instead.
logs/

# The study journey (D77): local events, and the database `npm run journey` builds from them
journey/

# DuckDB databases and their write-ahead logs, wherever they end up
*.duckdb
*.duckdb.wal
*.duckdb.tmp/

# Local environment
.env
.env.*
!.env.example

# Spike scripts (throwaway) and local environments
spike/
tools/.solver-out/
# Blind-solver hold files: they hold solver SQL, so they are never committed
tools/.solver-hold/
tools/.solver-view/
pipeline/.venv/
web/dist/
